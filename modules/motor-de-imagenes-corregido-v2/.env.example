# Never put this file or the service-account JSON in Git.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
# Optional. If omitted, the launcher uses:
# ./Luz IA secrets/vertex-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vertex-service-account.json
