QA_MODEL=gemini-2.5-flash
QA_AGENT_ROOT=C:\Users\Nico Trabajo\Downloads\luz-ia-studio (1)\LuzPhotodumpAgent
QA_REPO_ROOT=C:\Users\Nico Trabajo\Downloads\luz-ia-studio (1)

# Opcional: carpeta de Descargas del usuario. Si se completa, el agente
# busca ahi solo (sin que el usuario copie/renombre nada) archivos
# photodump_debug_*.json + sus imagenes hermanas (sueltas photodump_1.png,
# photodump_2.png... o dentro de un .zip descargado en la misma ventana de
# ~5 minutos) y arma la prueba en INBOX automaticamente.
QA_DOWNLOADS_DIR=C:\Users\Nico Trabajo\Downloads
QA_DOWNLOADS_POLL_SECONDS=30

# Por defecto 0: evaluar una prueba NO indexa referencias nuevas (rapido,
# solo unos pocos shots). Indexar el banco es un trabajo aparte, correr:
#   npm run index-references
# Subir esto a un numero > 0 solo si preferis volver al modo viejo donde
# cada evaluacion tambien indexa de a poco.
QA_REFERENCE_BATCH_SIZE=0

# Limite opcional de cuantas referencias indexar por corrida de
# `npm run index-references` (por defecto: todas las pendientes, sin limite).
# QA_INDEX_MAX_PER_RUN=50

# Segundos de espera entre cada llamada a Gemini/Vertex AI (una sola llamada
# a la vez, nunca en paralelo). Una cuenta de servicio nueva puede cortar con
# error 429 (RESOURCE_EXHAUSTED) si se manda todo junto -- 25s es lento pero
# seguro. Bajar solo si confirmas que tu cuota soporta mas velocidad.
QA_DELAY_BETWEEN_CALLS_SECONDS=25

# Mismas credenciales que ya usa la app en produccion (api/gemini/image-worker.ts),
# no una GEMINI_API_KEY nueva de Google AI Studio. Copialas desde Vercel:
#   vercel env pull .env.vercel.local --environment=production
# y desde ahi copia los 3 valores de GCP_PROJECT_ID, GEMINI_SERVICE_ACCOUNT_KEY
# (o GOOGLE_SERVICE_ACCOUNT_KEY) a este archivo.
GCP_PROJECT_ID=
GEMINI_SERVICE_ACCOUNT_KEY=
